<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile probe: does the engine (Chummer/Backend) build on its own, on .NET 8, without WinForms?
       The error list is the remaining Phase 1 work. Not shipped. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Chummer.CoreProbe</AssemblyName>
    <RootNamespace>Chummer</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);VSTHRD003;VSTHRD100;VSTHRD103;VSTHRD200;CA1068;IDE1006;IDE0130;CA1416;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Chummer/Backend/**/*.cs" />
    <Compile Include="../../../Chummer/7zip/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ben.Demystifier" Version="0.4.1" />
    <PackageReference Include="HtmlRenderer.Core" Version="1.5.2" />
    <PackageReference Include="itext" Version="9.8.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.NLogTarget" Version="2.23.0" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.14" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="4.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="18.12.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.14" />
    <PackageReference Include="XoshiroPRNG.Net" Version="1.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>
