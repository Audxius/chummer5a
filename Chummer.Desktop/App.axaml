<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Chummer.Desktop"
             x:Class="Chummer.Desktop.App"
             RequestedThemeVariant="Dark"
             Name="Chummer Native">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://chummer/Theme/NeonNoir.axaml" />
    <StyleInclude Source="avares://chummer/Theme/Sheet.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://chummer/Theme/Icons.axaml" />
        <ResourceInclude Source="avares://chummer/Theme/SheetResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
