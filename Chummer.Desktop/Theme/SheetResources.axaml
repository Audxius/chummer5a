<ResourceDictionary xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             xmlns:conv="using:Chummer.Desktop.Converters">
    <conv:IconKeyConverter x:Key="Icon" />
    <DataTemplate x:Key="ContactCard" x:DataType="vm:ContactCardViewModel">
      <Border Classes="dossier" Classes.enemy="{Binding IsEnemy}" Margin="0,0,0,10" Padding="18,14" CornerRadius="6">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="44,*,74,74,90" ColumnSpacing="12">
            <Border Classes="avatar" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top">
              <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SummaryDescription}" Classes="muted" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="Connection" Classes="muted" FontSize="11" /><TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold" FontSize="20" /></StackPanel>
            <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="Loyalty" Classes="muted" FontSize="11" /><TextBlock Text="{Binding LoyaltyText}" FontWeight="SemiBold" FontSize="20" /></StackPanel>
            <ToggleButton Grid.Column="4" Classes="contactExpand" Content="{Binding ExpansionLabel}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" VerticalAlignment="Top" Padding="10,6" />
          </Grid>
          <StackPanel IsVisible="{Binding IsExpanded}" Spacing="12">
            <Border Height="1" Background="{StaticResource BorderBrush}" />
            <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Border Classes="chip" Margin="0,0,6,4"><TextBlock Text="{Binding}" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Classes="muted" TextWrapping="Wrap" />
          <!-- Connection / loyalty -->
          <Grid ColumnDefinitions="100,*,Auto,Auto" RowDefinitions="Auto,Auto" ToolTip.Tip="Connection: how much clout and reach they have.  Loyalty: how much they care about you.">
            <TextBlock Text="CONNECTION" Classes="label" VerticalAlignment="Center" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding ConnectionPips}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:Boolean"><Border Classes="pip" Classes.on="{Binding}" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource CyanBrush}" MinWidth="22" TextAlignment="Right" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0" IsVisible="{Binding IsEditable}">
              <Button Classes="step" Content="−" Command="{Binding ConnectionDownCommand}" ToolTip.Tip="Lower connection" />
              <Button Classes="step" Content="+" Command="{Binding ConnectionUpCommand}" ToolTip.Tip="Raise connection" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="LOYALTY" Classes="label" VerticalAlignment="Center" Margin="0,4,0,0" />
            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LoyaltyPips}" VerticalAlignment="Center" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:Boolean"><Border Classes="pip loy" Classes.on="{Binding}" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LoyaltyText}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource MagentaBrush}" MinWidth="22" TextAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="8,4,0,0" IsVisible="{Binding IsEditable}">
              <Button Classes="step" Content="−" Command="{Binding LoyaltyDownCommand}" IsEnabled="{Binding LoyaltyEnabled}" ToolTip.Tip="Lower loyalty" />
              <Button Classes="step" Content="+" Command="{Binding LoyaltyUpCommand}" IsEnabled="{Binding LoyaltyEnabled}" ToolTip.Tip="Raise loyalty" />
            </StackPanel>
          </Grid>

          <!-- Dossier facts -->
          <ItemsControl ItemsSource="{Binding Facts}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ItemStat">
                <StackPanel Width="164" Margin="0,0,0,6">
                  <TextBlock Text="{Binding Label}" Classes="label" FontSize="9" />
                  <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border IsVisible="{Binding HasNotes}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0" Padding="8,2">
            <TextBlock Text="{Binding Notes}" Classes="muted" TextWrapping="Wrap" ToolTip.Tip="{Binding Notes}" />
          </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Edit contact…" Command="{Binding EditCommand}" />
              <Button Content="Delete" Classes="act danger" Command="{Binding DeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- Inventory slot: a square RPG-style cell with the item icon, category-coloured rim and corner badges. -->
    <DataTemplate x:Key="InventorySlot" x:DataType="vm:InventoryItemViewModel">
      <Button Classes="slot" Width="100" Opacity="{Binding Opacity}"
              Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).SelectInventoryItemCommand}" CommandParameter="{Binding}"
              ToolTip.Tip="{Binding Name}" ToolTip.ShowDelay="600">
        <StackPanel Spacing="5">
          <Grid Width="100" Height="100">
            <Border Classes="well" Background="{Binding AccentFill}" BorderBrush="{Binding AccentBrush}" Opacity="0.85" />
            <Border Classes="well" BorderBrush="#40000000" Margin="1" Background="Transparent" />
            <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="54" Height="54" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Classes="ring" Classes.selected="{Binding IsSelected}" BorderBrush="{Binding AccentBrush}" BoxShadow="{Binding AccentGlow}" />
            <!-- top-left: rating / armor value -->
            <Border Classes="badge" IsVisible="{Binding HasRatingBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
              <TextBlock Text="{Binding RatingBadge}" Foreground="{Binding AccentBrush}" />
            </Border>
            <!-- top-right: equipped / wireless / active commlink -->
            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" IsHitTestVisible="False">
              <Border Classes="badge" IsVisible="{Binding IsActiveCommlink}" ToolTip.Tip="Active commlink">
                <PathIcon Data="{StaticResource Icon.Star}" Width="10" Height="10" Margin="0,2" Foreground="{StaticResource YellowBrush}" />
              </Border>
              <Border Classes="badge" IsVisible="{Binding ShowWirelessBadge}">
                <PathIcon Data="{StaticResource Icon.Item.Wifi}" Width="10" Height="10" Margin="0,2" Foreground="{StaticResource CyanBrush}" />
              </Border>
              <Border Classes="badge" IsVisible="{Binding ShowEquippedMarker}" BorderBrush="#8839FF88">
                <TextBlock Text="E" Foreground="{StaticResource GreenBrush}" />
              </Border>
            </StackPanel>
            <!-- bottom-right: stack count / rounds left -->
            <Border Classes="badge" IsVisible="{Binding HasQuantityBadge}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4">
              <TextBlock Text="{Binding QuantityBadge}" Foreground="{StaticResource TextBrush}" />
            </Border>
            <!-- bottom-left: has mods/contents -->
            <Border Classes="badge" IsVisible="{Binding HasChildren}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4">
              <TextBlock Text="+" Foreground="{StaticResource MutedBrush}" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                     Height="30" Foreground="{StaticResource TextBrush}" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <!-- Nested mini-slot for mods, accessories and contained items in the detail panel. -->
    <DataTemplate x:Key="InventoryMiniSlot" x:DataType="vm:InventoryItemViewModel">
      <Button Classes="slot" Width="52" Margin="0,0,6,6" Opacity="{Binding Opacity}"
              Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).SelectInventoryItemCommand}" CommandParameter="{Binding}"
              ToolTip.Tip="{Binding Name}" ToolTip.ShowDelay="150">
        <Grid Width="52" Height="52">
          <Border Classes="well" Background="{Binding AccentFill}" BorderBrush="{Binding AccentBrush}" Opacity="0.7" />
          <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="26" Height="26" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Classes="ring" BorderBrush="{Binding AccentBrush}" />
          <Border Classes="badge" IsVisible="{Binding HasRatingBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" Padding="2,0">
            <TextBlock Text="{Binding RatingBadge}" FontSize="8" Foreground="{Binding AccentBrush}" />
          </Border>
          <Border Classes="badge" IsVisible="{Binding HasQuantityBadge}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2" Padding="2,0">
            <TextBlock Text="{Binding QuantityBadge}" FontSize="8" Foreground="{StaticResource TextBrush}" />
          </Border>
        </Grid>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="CardGroup" x:DataType="vm:InventoryGroupViewModel">
      <StackPanel Spacing="8" Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding Name}" Classes="h2" />
          <TextBlock Text="{Binding CountText}" Classes="label" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InventoryItemViewModel">
              <Border Classes="tile" Opacity="{Binding Opacity}" ToolTip.Placement="Right" ToolTip.ShowDelay="250">
                <ToolTip.Tip>
                  <StackPanel Width="320" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="28" Height="28" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" MaxWidth="270" />
                        <TextBlock Text="{Binding Category}" Classes="label" />
                      </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Stats}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemStat">
                          <StackPanel Width="100" Margin="0,0,4,6">
                            <TextBlock Text="{Binding Label}" Classes="label" />
                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ContentsText}" IsVisible="{Binding HasContents}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" TextWrapping="Wrap" Classes="muted" FontSize="12" MaxHeight="120" />
                    <Grid ColumnDefinitions="*,*,*">
                      <StackPanel>
                        <TextBlock Text="COST" Classes="label" />
                        <TextBlock Text="{Binding Cost}" Foreground="{StaticResource YellowBrush}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="AVAIL" Classes="label" />
                        <TextBlock Text="{Binding Avail}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="SOURCE" Classes="label" />
                        <TextBlock Text="{Binding Source}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </ToolTip.Tip>
                <Grid RowDefinitions="Auto,*,Auto">
                  <Grid ColumnDefinitions="*,Auto">
                    <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="30" Height="30" HorizontalAlignment="Left" />
                    <Border Grid.Column="1" Classes="chip" IsVisible="{Binding HasBadge}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource CyanBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,8,0,4" Foreground="{StaticResource TextBrush}" VerticalAlignment="Top" />
                  <TextBlock Grid.Row="2" Text="{Binding Headline}" Classes="label" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
</ResourceDictionary>
