<Styles xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             xmlns:conv="using:Chummer.Desktop.Converters">
    <Style Selector="Border.dossier">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
    <Style Selector="Border.dossier:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Border.dossier.enemy">
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
    </Style>
    <Style Selector="Border.avatar">
      <Setter Property="Background" Value="{StaticResource CyanDimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.dossier.enemy Border.avatar">
      <Setter Property="Background" Value="#33FF3355" />
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
    </Style>
    <Style Selector="Border.pip">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="Border.pip.on">
      <Setter Property="Background" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Border.pip.loy.on">
      <Setter Property="Background" Value="{StaticResource MagentaBrush}" />
    </Style>
    <Style Selector="Button.step">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <!-- A row or chip that rolls in the Dice Terminal when clicked. -->
    <Style Selector="Button.roll">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.roll:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A00E5FF" />
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Button.roll:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3300E5FF" />
    </Style>
    <Style Selector="Button.roll:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.roll PathIcon.rollhint">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Button.roll:pointerover PathIcon.rollhint">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="ToggleButton.section:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.cm">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.cm:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#55FFFFFF" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="196" />
      <Setter Property="Height" Value="134" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
      <Setter Property="BoxShadow" Value="0 0 14 0 #4400E5FF" />
    </Style>
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="MinWidth" Value="150" />
    </Style>
    <Style Selector="Border.edgepip">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="2,2,8,8" />
      <Setter Property="RenderTransform" Value="rotate(45deg)" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.edgepip.on">
      <Setter Property="Background" Value="{StaticResource MagentaBrush}" />
      <Setter Property="BoxShadow" Value="0 0 8 0 #66FF2E88" />
    </Style>
    <Style Selector="Border.attrrow">
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.attrrow:pointerover">
      <Setter Property="Background" Value="#0D00E5FF" />
    </Style>
    <Style Selector="Border.attrpip">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="Border.attrpip.on">
      <Setter Property="Background" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Button.step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
      <Setter Property="Background" Value="#1A00E5FF" />
    </Style>
    <Style Selector="Button.step.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
      <Setter Property="Background" Value="#33FF3355" />
    </Style>

    <!-- ===== Inventory: game-style slots, badges and the detail panel ===== -->
    <Style Selector="Button.slot">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.slot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Border.well">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.ring">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.slot:pointerover Border.ring">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.ring.selected">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.slot:pointerover Border.ring.selected">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Background" Value="#E607090D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.addslot">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Background" Value="#0AFFFFFF" />
    </Style>
    <Style Selector="Button.slot:pointerover Border.addslot">
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
      <Setter Property="Background" Value="#1400E5FF" />
    </Style>
    <Style Selector="Border.detail">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.loadout">
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.act">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.act.on">
      <Setter Property="Background" Value="{StaticResource CyanDimBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.act.fire">
      <Setter Property="Background" Value="#FFFF4D5E" />
      <Setter Property="BorderBrush" Value="#FFFF4D5E" />
      <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
      <Setter Property="FontWeight" Value="Black" />
    </Style>
    <Style Selector="Button.act.fire:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFF7A87" />
      <Setter Property="BorderBrush" Value="#FFFF7A87" />
      <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
      <Setter Property="BoxShadow" Value="0 0 14 0 #88FF4D5E" />
    </Style>
    <Style Selector="Button.act.danger">
      <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
      <Setter Property="BorderBrush" Value="#88FF3B4E" />
    </Style>
    <Style Selector="Button.act.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FF3B4E" />
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BoxShadow" Value="0 0 12 0 #66FF3B4E" />
    </Style>
    <Style Selector="Button.act.money">
      <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
      <Setter Property="BorderBrush" Value="#88F3E600" />
    </Style>
    <Style Selector="Button.act.money:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33F3E600" />
      <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BoxShadow" Value="0 0 12 0 #55F3E600" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
</Styles>
