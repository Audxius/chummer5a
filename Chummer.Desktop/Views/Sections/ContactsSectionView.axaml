<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             xmlns:conv="using:Chummer.Desktop.Converters"
             x:Class="Chummer.Desktop.Views.Sections.ContactsSectionView"
             x:DataType="vm:CharacterViewModel">
  <DockPanel Margin="28,22,28,0">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,14" ColumnDefinitions="*,Auto">
      <TextBox Text="{Binding NetworkFilter}" PlaceholderText="Search contacts by name, role, location, payment, vice, notes… or spirits and sprites" Padding="40,9,10,9" />
      <PathIcon Data="{StaticResource Icon.Search}" Width="15" Height="15" HorizontalAlignment="Left" Margin="14,0,0,0" Classes="muted" IsHitTestVisible="False" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
        <Button Classes="primary" Content="+ CONTACT" Command="{Binding AddContactCommand}" />
        <Button Classes="hot" Content="+ ENEMY" Command="{Binding AddEnemyCommand}" />
        <Button Classes="ghost" Content="+ PET" Command="{Binding AddPetCommand}" />
      </StackPanel>
    </Grid>
    <ScrollViewer>
      <StackPanel Margin="0,0,0,22" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasContactCards}">
          <TextBlock Text="CONTACTS" Classes="h2" />
          <TextBlock Text="{Binding ContactCountText}" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="sorted by connection + loyalty" Classes="muted" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding ContactCards}" ItemTemplate="{StaticResource ContactCard}" IsVisible="{Binding HasContactCards}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="ENEMIES" Classes="h2" Foreground="{StaticResource RedBrush}" IsVisible="{Binding HasEnemyCards}" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding EnemyCards}" ItemTemplate="{StaticResource ContactCard}" IsVisible="{Binding HasEnemyCards}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="PETS" Classes="h2" IsVisible="{Binding HasPetCards}" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding PetCards}" ItemTemplate="{StaticResource ContactCard}" IsVisible="{Binding HasPetCards}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding NetworkGroups}" ItemTemplate="{StaticResource CardGroup}" Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
