<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             xmlns:conv="using:Chummer.Desktop.Converters"
             xmlns:controls="using:Chummer.Desktop.Views.Controls"
             x:Class="Chummer.Desktop.Views.Sections.AttributesSectionView"
             x:DataType="vm:CharacterViewModel">
  <UserControl.Resources>
    <!-- One attribute as an aligned row: icon, name, rating pips, value (augmented), raise action. -->
    <DataTemplate x:Key="AttributeRow" x:DataType="vm:AttributeViewModel">
      <Border Classes="attrrow" ToolTip.Tip="{Binding Breakdown}">
        <Grid ColumnDefinitions="28,*,82,Auto">
          <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="20" Height="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding LongName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Abbrev}" Classes="muted" FontSize="11" ToolTip.Tip="{Binding RangeText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding ValueText}" FontSize="24" FontWeight="Black" />
            <TextBlock Text="{Binding AugmentedText}" IsVisible="{Binding IsAugmented}" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" ToolTip.Tip="Augmented value" />
          </StackPanel>
          <!-- Career: one button with the karma cost; create: -/+ -->
          <Panel Grid.Column="3" Width="132" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button IsVisible="{Binding IsCareer}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding ImproveCommand}" IsEnabled="{Binding CanImprove}" ToolTip.Tip="{Binding QuickRaiseTip}" ToolTip.ShowOnDisabled="True">
              <TextBlock Text="{Binding ImproveButtonText}" FontWeight="Bold" FontSize="11" />
            </Button>
            <Grid IsVisible="{Binding IsCreate}" ColumnDefinitions="Auto,*,Auto">
              <Button Classes="step" Content="−" Command="{Binding LowerCommand}" ToolTip.Tip="Lower by 1 (karma points first)" />
              <TextBlock Grid.Column="1" Text="{Binding PointsText}" Classes="muted" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Grid.Column="2" Classes="step" Content="+" Command="{Binding RaiseCommand}" ToolTip.Tip="Raise by 1 (priority points first, then karma)" />
            </Grid>
          </Panel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="28,22" Spacing="20" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4"><TextBlock Text="Attributes" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Base ratings, augmented values and advancement" Classes="muted" /></StackPanel>
      <Grid x:Name="AttributeRatings" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="20">
        <Border Classes="panel">
          <StackPanel Spacing="4">
            <TextBlock Text="Physical" Classes="h2" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding PhysicalAttributes}" ItemTemplate="{StaticResource AttributeRow}" />
          </StackPanel>
        </Border>
        <Border x:Name="MentalPanel" Grid.Column="1" Classes="panel">
          <StackPanel Spacing="4">
            <TextBlock Text="Mental" Classes="h2" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding MentalAttributes}" ItemTemplate="{StaticResource AttributeRow}" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="AttributeSession" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="20">
        <Border Classes="panel">
          <StackPanel Spacing="4">
            <TextBlock Text="Special" Classes="h2" Foreground="{StaticResource MagentaBrush}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding SpecialAttributes}" ItemTemplate="{StaticResource AttributeRow}" />
            <Expander Header="Permanent Edge changes" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding SpecialAttributes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AttributeViewModel">
                  <Button IsVisible="{Binding CanBurnEdge}" Classes="hot" HorizontalAlignment="Right" Margin="0,4,0,0"
                          Command="{Binding BurnEdgeCommand}" Content="BURN 1 EDGE PERMANENTLY" ToolTip.Tip="Burning Edge lowers the attribute itself (to survive certain death)." />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Expander>
          </StackPanel>
        </Border>
        <Border x:Name="SessionEdgePanel" Grid.Column="1" Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="Edge this session" Classes="h2" Foreground="{StaticResource MagentaBrush}" />
            <TextBlock Text="Temporary Edge. Refresh when your GM allows." Classes="muted" TextWrapping="Wrap" />
            <controls:EdgePoolView />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
