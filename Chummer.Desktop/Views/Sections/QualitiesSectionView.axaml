<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             xmlns:conv="using:Chummer.Desktop.Converters"
             x:Class="Chummer.Desktop.Views.Sections.QualitiesSectionView"
             x:DataType="vm:CharacterViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://chummer/Theme/EditorResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- One quality: type-coloured edge, name / extra, origin and source chips, level stepper, karma value, remove. -->
      <DataTemplate x:Key="QualityCard" x:DataType="vm:QualityViewModel">
        <Border Classes="qcard" Classes.negative="{Binding IsNegative}" Margin="0,0,0,8" ToolTip.Placement="Pointer" ToolTip.ShowDelay="300">
          <ToolTip.Tip>
            <StackPanel Width="340" Spacing="6">
              <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Extra}" IsVisible="{Binding HasExtra}" Classes="accent" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TypeLabel}" Classes="label" />
              <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EffectSummary}" IsVisible="{Binding HasEffectSummary}" TextWrapping="Wrap" Foreground="{StaticResource CyanBrush}" />
              <TextBlock Text="{Binding KarmaTip}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Origin}" IsVisible="{Binding HasOrigin}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SourceTip}" IsVisible="{Binding HasSource}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" TextWrapping="Wrap" FontSize="12" MaxHeight="200" />
            </StackPanel>
          </ToolTip.Tip>
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Extra}" IsVisible="{Binding HasExtra}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                <Border Classes="chip" Padding="5,1" IsVisible="{Binding HasOrigin}">
                  <TextBlock Text="{Binding Origin}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MagentaBrush}" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSource}">
                  <PathIcon Data="{StaticResource Edit.Book}" Width="10" Height="10" Classes="muted" />
                  <TextBlock Text="{Binding Source}" Classes="label" FontSize="10" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0" IsVisible="{Binding HasLevels}">
              <Button Classes="step" Content="−" Command="{Binding LevelDownCommand}" IsEnabled="{Binding CanLevelDown}" ToolTip.Tip="{Binding LevelDownTip}" ToolTip.ShowOnDisabled="True" />
              <StackPanel VerticalAlignment="Center" MinWidth="38">
                <TextBlock Text="LEVEL" Classes="label" FontSize="8" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding LevelText}" FontWeight="Bold" HorizontalAlignment="Center" />
              </StackPanel>
              <Button Classes="step" Content="+" Command="{Binding LevelUpCommand}" IsEnabled="{Binding CanLevelUp}" ToolTip.Tip="{Binding LevelUpTip}" ToolTip.ShowOnDisabled="True" />
            </StackPanel>
            <Border Grid.Column="2" Classes="karma" Classes.negative="{Binding IsNegative}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{Binding KarmaTip}">
              <TextBlock Text="{Binding KarmaText}" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" />
            </Border>
            <Button Grid.Column="3" Classes="icon" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}"
                    ToolTip.Tip="{Binding RemoveTip}" ToolTip.ShowOnDisabled="True">
              <PathIcon Data="{StaticResource Edit.Remove}" Width="15" Height="15" />
            </Button>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.qcard">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="12,9,10,9" />
    </Style>
    <Style Selector="Border.qcard.negative">
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
    </Style>
    <Style Selector="Border.qcard:pointerover">
      <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
    </Style>
    <Style Selector="Border.karma">
      <Setter Property="MinWidth" Value="50" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#2239FF88" />
      <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource GreenBrush}" />
    </Style>
    <Style Selector="Border.karma.negative">
      <Setter Property="Background" Value="#22FF3B4E" />
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource RedBrush}" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled">
      <Setter Property="Opacity" Value="0.25" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="28,22,28,0">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,14">
      <TextBlock Text="{Binding QualityHint}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="ADD LIFE MODULE" Command="{Binding AddLifeModuleCommand}" IsVisible="{Binding IsLifeModuleBuild}" />
      <Button Grid.Column="2" Classes="primary" Command="{Binding AddQualityCommand}" ToolTip.Tip="Pick a positive or negative quality">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Edit.Add}" Width="14" Height="14" />
          <TextBlock Text="ADD QUALITY" FontWeight="Bold" />
        </StackPanel>
      </Button>
    </Grid>
    <ScrollViewer>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,0,0,22">
        <StackPanel Margin="0,0,10,0" Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource Icon.Quality}" Width="16" Height="16" Foreground="{StaticResource GreenBrush}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="POSITIVE" Classes="h2" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding PositiveQualitySummary}" Classes="label" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding PositiveQualities}" ItemTemplate="{StaticResource QualityCard}" />
          <TextBlock Text="No positive qualities." Classes="muted" IsVisible="{Binding !PositiveQualities.Count}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource Icon.Quality}" Width="16" Height="16" Foreground="{StaticResource RedBrush}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="NEGATIVE" Classes="h2" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding NegativeQualitySummary}" Classes="label" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding NegativeQualities}" ItemTemplate="{StaticResource QualityCard}" />
          <TextBlock Text="No negative qualities." Classes="muted" IsVisible="{Binding !NegativeQualities.Count}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0" Spacing="8" IsVisible="{Binding LifeModuleQualities.Count}">
          <TextBlock Text="LIFE MODULES" Classes="h2" />
          <ItemsControl ItemsSource="{Binding LifeModuleQualities}" ItemTemplate="{StaticResource QualityCard}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
