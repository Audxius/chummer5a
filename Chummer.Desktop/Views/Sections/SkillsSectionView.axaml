<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             xmlns:conv="using:Chummer.Desktop.Converters"
             x:Class="Chummer.Desktop.Views.Sections.SkillsSectionView"
             x:DataType="vm:CharacterViewModel">
  <DockPanel Margin="28,22,28,0">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,14">
      <TextBox Width="320" Text="{Binding SkillFilter}" PlaceholderText="Search skills...">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="8,0,0,0" Classes="muted" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <CheckBox Content="Show untrained" IsChecked="{Binding ShowUntrainedSkills}" />
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding SkillCategories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SkillCategoryViewModel">
            <Border Classes="panel lit" Width="420" Margin="0,0,16,16" VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                  <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="20" Height="20" />
                  <TextBlock Text="{Binding Name}" Classes="h2" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Skills}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="-6,0">
                        <Button Classes="roll" IsEnabled="{Binding IsRollable}" ToolTip.Tip="{Binding RollTip}"
                                Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding RollName}">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Specialization}" IsVisible="{Binding HasSpecialization}" FontSize="10"
                                         Foreground="{StaticResource MagentaBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <PathIcon Grid.Column="1" Classes="rollhint" Data="{StaticResource Icon.Dice}" Margin="0,0,6,0" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Pips}" VerticalAlignment="Center" Margin="0,0,8,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Boolean">
                              <Border Width="7" Height="12" CornerRadius="1" Classes.on="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                          <ItemsControl.Styles>
                            <Style Selector="Border">
                              <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                            </Style>
                            <Style Selector="Border.on">
                              <Setter Property="Background" Value="{StaticResource CyanBrush}" />
                            </Style>
                          </ItemsControl.Styles>
                        </ItemsControl>
                            <Border Grid.Column="3" Classes="chip" MinWidth="34" ToolTip.Tip="Dice pool">
                              <TextBlock Text="{Binding Pool}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                            </Border>
                          </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="roll" IsVisible="{Binding HasSpecPool}" Margin="2,0,0,0" Padding="2"
                                ToolTip.Tip="{Binding Specialization, StringFormat='Click to roll with the {0} specialization'}"
                                Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding SpecRollName}">
                          <Border Classes="chip" MinWidth="34" Background="{StaticResource MagentaDimBrush}" BorderBrush="{StaticResource MagentaBrush}">
                            <TextBlock Text="{Binding SpecPool}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource MagentaBrush}" />
                          </Border>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
