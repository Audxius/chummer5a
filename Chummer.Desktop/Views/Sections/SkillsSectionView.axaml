<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             x:Class="Chummer.Desktop.Views.Sections.SkillsSectionView"
             x:DataType="vm:CharacterViewModel">
  <!-- One aligned table: icon | skill + specializations | attribute | rating | pool | spec pool | edit.
       Every row rolls on click; the spec chips and the spec-pool cell roll with that specialization. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.groupRating"><Setter Property="Foreground" Value="{StaticResource CyanBrush}" /></Style>
    <Style Selector="TextBlock.groupRating.muted"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Style>
    <Style Selector="Button.seg">
      <Setter Property="Theme" Value="{StaticResource StableButtonTheme}" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1.5" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="Button.seg:pointerover">
      <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.seg:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Button.seg.on:pointerover">
      <Setter Property="Background" Value="{StaticResource CyanBrush}" />
      <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
    </Style>
    <Style Selector="Button.seg.on">
      <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
      <Setter Property="Background" Value="{StaticResource CyanBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF5CF0FF" />
      <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
    </Style>
    <Style Selector="Button.add">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.colhead.on">
      <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    </Style>
    <!-- Row background button: hover lights the whole row. -->
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="#141F2C" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1400E5FF" />
      <Setter Property="BorderBrush" Value="#5500E5FF" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3300E5FF" />
    </Style>
    <Style Selector="Button.row:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#141F2C" />
    </Style>
    <!-- Small chip-buttons inside a row. -->
    <Style Selector="Button.chipbtn">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.spec">
      <Setter Property="Foreground" Value="{StaticResource MagentaBrush}" />
      <Setter Property="BorderBrush" Value="#88FF2E88" />
      <Setter Property="Background" Value="#1AFF2E88" />
    </Style>
    <Style Selector="Button.spec:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MagentaDimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BoxShadow" Value="0 0 10 0 #55FF2E88" />
    </Style>
    <Style Selector="Button.addspec">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
          </Style>
    <!-- "+ SPEC" only shows up on the row under the pointer: keeps the table calm. -->
    <Style Selector="Grid.skillrow Button.hover">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.skillrow:pointerover Button.hover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tag">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="Button.tag:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <!-- Karma purchase button (career). -->
    <Style Selector="Button.buy">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.buy:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#3A4B61" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="Button.del">
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.del:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
      <Setter Property="Background" Value="#22FF3B4E" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.step:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#2A3A4D" />
    </Style>
    <Style Selector="TextBlock.pool">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.pool.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="28,18,28,0">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Skills" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Add skill…"><Button.Flyout><MenuFlyout>
          <MenuItem Header="Knowledge or language…" Command="{Binding AddKnowledgeSkillCommand}" />
          <MenuItem Header="Exotic skill…" Command="{Binding AddExoticSkillCommand}" />
        </MenuFlyout></Button.Flyout></Button>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ToggleButton Classes="section" Content="Skills" IsChecked="{Binding !IsSkillGroupsPage, Mode=OneWay}" Command="{Binding ShowSkillsPageCommand}" />
        <ToggleButton Classes="section" Content="Skill groups" IsChecked="{Binding IsSkillGroupsPage, Mode=OneWay}" Command="{Binding ShowGroupsPageCommand}" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBox Text="{Binding SkillFilter}" PlaceholderText="Search skills, groups or specializations…">
          <TextBox.InnerLeftContent><PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="8,0,0,0" Classes="muted" /></TextBox.InnerLeftContent>
        </TextBox>
        <Button Grid.Column="1" Content="View options" IsVisible="{Binding !IsSkillGroupsPage}"><Button.Flyout><MenuFlyout>
          <MenuItem Header="Show untrained skills" ToggleType="CheckBox" IsChecked="{Binding ShowUntrainedSkills, Mode=TwoWay}" />
          <MenuItem Header="Group by category" ToggleType="CheckBox" IsChecked="{Binding GroupSkillsByCategory, Mode=TwoWay}" />
        </MenuFlyout></Button.Flyout></Button>
      </Grid>
      <WrapPanel IsVisible="{Binding !IsSkillGroupsPage}">
        <TextBlock Text="Sort" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Classes="seg" Classes.on="{Binding SortIsPool}" Content="{Binding PoolSortLabel}" Command="{Binding SortSkillsCommand}" CommandParameter="{x:Static vm:SkillSortMode.DicePool}" />
        <Button Classes="seg" Classes.on="{Binding SortIsName}" Content="{Binding NameSortLabel}" Command="{Binding SortSkillsCommand}" CommandParameter="{x:Static vm:SkillSortMode.Name}" />
        <Button Classes="seg" Classes.on="{Binding SortIsRating}" Content="{Binding RatingSortLabel}" Command="{Binding SortSkillsCommand}" CommandParameter="{x:Static vm:SkillSortMode.Rating}" />
        <Button Classes="seg" Classes.on="{Binding SortIsCategory}" Content="{Binding CategorySortLabel}" Command="{Binding SortSkillsCommand}" CommandParameter="{x:Static vm:SkillSortMode.Category}" />
        <TextBlock Text="{Binding SkillCountText}" Classes="muted" VerticalAlignment="Center" Margin="14,0,0,0" />
      </WrapPanel>
    </StackPanel>

<Border DockPanel.Dock="Top" Margin="0,0,0,14" Classes="panel hot" IsVisible="{Binding HasSkillBudget}">
            <ItemsControl ItemsSource="{Binding SkillBudget}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemStat">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <TextBlock Text="{Binding Label}" Classes="label" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Bold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
    <Grid ColumnDefinitions="*">
      <!-- The table -->
      <DockPanel IsVisible="{Binding !IsSkillGroupsPage}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="36,*,58,62,66,66,186" Margin="0,0,14,0" Height="28">
          <Border Grid.ColumnSpan="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Column="1" Text="SKILL  //  SPECIALIZATIONS" Classes="colhead" Classes.on="{Binding SortIsName}" />
          <TextBlock Grid.Column="2" Text="ATTR" Classes="colhead" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="RATING" Classes="colhead" Classes.on="{Binding SortIsRating}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="4" Text="POOL" Classes="colhead" Classes.on="{Binding SortIsPool}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="5" Text="SPEC" Classes="colhead" HorizontalAlignment="Center" Foreground="{StaticResource MagentaBrush}" />
          <TextBlock Grid.Column="6" Text="RAISE (KARMA)" Classes="colhead" HorizontalAlignment="Right" Margin="0,0,8,0" IsVisible="{Binding IsSkillsCareer}" />
          <TextBlock Grid.Column="6" Text="POINTS        KARMA" Classes="colhead" HorizontalAlignment="Right" Margin="0,0,14,0" IsVisible="{Binding IsSkillsCreate}" />
        </Grid>
        <ScrollViewer Padding="0,0,14,24">
          <ItemsControl ItemsSource="{Binding SkillRows}">
            <ItemsControl.DataTemplates>
              <!-- Category heading (grouped mode) -->
              <DataTemplate DataType="vm:SkillHeaderRow">
                <Grid ColumnDefinitions="36,Auto,Auto,*" Margin="0,16,0,2" Height="30">
                  <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="16" Height="16" HorizontalAlignment="Left" Margin="6,0,0,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="h2" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="label" VerticalAlignment="Center" Margin="10,0,0,0" />
                  <Border Grid.Column="3" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>
              </DataTemplate>

              <!-- Skill row -->
              <DataTemplate DataType="vm:SkillViewModel">
                <Grid Classes="skillrow" ColumnDefinitions="36,*,58,62,66,66,186" MinHeight="42">
                  <Button Grid.ColumnSpan="7" Classes="row" IsEnabled="{Binding IsRollable}" ToolTip.Tip="{Binding RollTip}"
                          Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding RollName}" />
                  <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="16" Height="16" IsHitTestVisible="False"
                            HorizontalAlignment="Left" Margin="6,0,0,0" Classes.muted="{Binding IsDefaulting}" />

                  <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,5,8,5">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"
                               Classes.muted="{Binding IsDefaulting}" />
                    <Button Classes="chipbtn tag" Content="{Binding TypeText}" IsVisible="{Binding HasTypeText}" IsEnabled="{Binding CanChangeType}"
                            Command="{Binding ChangeTypeCommand}" ToolTip.Tip="Knowledge skill type (click to change)" />
                    <Button Classes="chipbtn tag" Content="{Binding NativeToggleText}" IsVisible="{Binding ShowNativeToggle}" IsEnabled="{Binding CanToggleNative}"
                            Command="{Binding ToggleNativeCommand}" ToolTip.Tip="Native languages are free and have no rating (limited slots)" />
                    <Button Classes="chipbtn tag hover" Content="RENAME" IsVisible="{Binding CanRename}" Command="{Binding RenameCommand}" ToolTip.Tip="Rename this knowledge skill" />
                    <ItemsControl ItemsSource="{Binding Specs}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkillSpecChip">
                          <Button Classes="chipbtn spec" Content="{Binding Name}" ToolTip.Tip="{Binding Tip}"
                                  Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding RollName}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="chipbtn addspec hover" Content="{Binding AddSpecText}" IsVisible="{Binding ShowAddSpec}" IsEnabled="{Binding CanAddSpec}"
                            Command="{Binding AddSpecCommand}" ToolTip.Tip="{Binding AddSpecTip}" />
                  </WrapPanel>

                  <TextBlock Grid.Column="2" Text="{Binding Attribute}" Classes="muted" FontSize="12" LetterSpacing="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <TextBlock Grid.Column="3" Text="{Binding RatingText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False" Classes.muted="{Binding IsDefaulting}" />
                  <TextBlock Grid.Column="4" Text="{Binding PoolText}" Classes="pool" IsHitTestVisible="False" Classes.muted="{Binding !IsRollable}" />
                  <Button Grid.Column="5" Classes="chipbtn spec" IsVisible="{Binding HasSpecPool}" HorizontalAlignment="Center" Margin="0" Padding="8,2"
                          ToolTip.Tip="{Binding SpecPoolTip}"
                          Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding SpecRollName}">
                    <TextBlock Text="{Binding SpecPoolText}" FontSize="15" FontWeight="Bold" />
                  </Button>

                  <!-- Career: buy the next rating -->
                  <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding IsCareer}" Margin="0,0,4,0">
                    <Button Classes="buy" IsVisible="{Binding ShowImprove}" IsEnabled="{Binding CanImprove}" Command="{Binding ImproveCommand}" ToolTip.Tip="{Binding ImproveTip}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{StaticResource Icon.Karma}" Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" IsVisible="{Binding !IsAtMaximum}" />
                        <TextBlock Text="{Binding ImproveText}" />
                      </StackPanel>
                    </Button>
                    <Panel Width="30"><Button Classes="del" Content="✕" IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete this skill" /></Panel>
                  </StackPanel>

                  <!-- Create: skill points and karma levels, plus native / karma-spec toggles -->
                  <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" IsVisible="{Binding IsCreate}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding ShowBase}">
                      <Button Classes="step" Content="−" Command="{Binding BaseDownCommand}" IsEnabled="{Binding CanBaseDown}" ToolTip.Tip="Remove a skill point" />
                      <TextBlock Text="{Binding BaseText}" MinWidth="20" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                      <Button Classes="step" Content="+" Command="{Binding BaseUpCommand}" IsEnabled="{Binding CanBaseUp}" ToolTip.Tip="Spend a skill point" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                      <Button Classes="step" Content="−" Command="{Binding KarmaDownCommand}" IsEnabled="{Binding CanKarmaDown}" ToolTip.Tip="Remove a karma-bought level" />
                      <TextBlock Text="{Binding KarmaText}" MinWidth="20" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MagentaBrush}" />
                      <Button Classes="step" Content="+" Command="{Binding KarmaUpCommand}" IsEnabled="{Binding CanKarmaUp}" ToolTip.Tip="Buy a level with karma" />
                    </StackPanel>
                    <Panel Width="30"><Button Classes="del" Content="✕" IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete this skill" /></Panel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Side: budgets (create) and skill groups -->
      <ScrollViewer IsVisible="{Binding IsSkillGroupsPage}" Padding="0,0,0,24">
        <StackPanel Spacing="14">


          <Border Classes="panel lit" Padding="14,12">
            <StackPanel>
              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <PathIcon Data="{StaticResource Icon.Skills}" Width="16" Height="16" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="SKILL GROUPS" Classes="h2" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="No skill groups match your search." Classes="muted" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding !HasSkillGroups}" />
              <ItemsControl ItemsSource="{Binding SkillGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SkillGroupViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="34" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                      <Border Grid.ColumnSpan="3" BorderBrush="#141F2C" BorderThickness="0,0,0,1" />
                      <StackPanel VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Members}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding RatingText}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="8,0"
                                 Classes="groupRating" Classes.muted="{Binding IsBroken}" />
                      <Button Grid.Column="2" Classes="buy" IsVisible="{Binding ShowImprove}" IsEnabled="{Binding CanImprove}" Command="{Binding ImproveCommand}"
                              ToolTip.Tip="{Binding ImproveTip}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <PathIcon Data="{StaticResource Icon.Karma}" Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" IsVisible="{Binding !IsAtMaximum}" />
                          <TextBlock Text="{Binding ImproveText}" />
                        </StackPanel>
                      </Button>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsCreate}">
                        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding ShowBase}">
                          <Button Classes="step" Content="−" Command="{Binding BaseDownCommand}" IsEnabled="{Binding CanBaseDown}" ToolTip.Tip="Remove a group point" />
                          <TextBlock Text="{Binding BaseText}" MinWidth="18" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                          <Button Classes="step" Content="+" Command="{Binding BaseUpCommand}" IsEnabled="{Binding CanBaseUp}" ToolTip.Tip="Spend a group point" />
                        </StackPanel>
                        <Button Classes="step" Content="−" Command="{Binding KarmaDownCommand}" IsEnabled="{Binding CanKarmaDown}" Margin="6,0,0,0" ToolTip.Tip="Remove a karma-bought level" />
                        <TextBlock Text="{Binding KarmaText}" MinWidth="18" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MagentaBrush}" />
                        <Button Classes="step" Content="+" Command="{Binding KarmaUpCommand}" IsEnabled="{Binding CanKarmaUp}" ToolTip.Tip="Buy a level with karma" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>


        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
