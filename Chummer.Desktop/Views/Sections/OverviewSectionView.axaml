<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chummer.Desktop.ViewModels" xmlns:conv="using:Chummer.Desktop.Converters" xmlns:controls="using:Chummer.Desktop.Views.Controls" x:Class="Chummer.Desktop.Views.Sections.OverviewSectionView" x:DataType="vm:CharacterViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="OverviewStat" x:DataType="vm:ItemStat">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,7">
        <TextBlock Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="step" IsVisible="{Binding IsRollable}" Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding RollName}" ToolTip.Tip="{Binding RollName}">
          <PathIcon Data="{StaticResource Icon.Dice}" Width="14" Height="14" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Margin="28,22" Spacing="20">
      <StackPanel Spacing="4">
        <TextBlock Text="Overview" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Your runner at a glance" Classes="muted" />
      </StackPanel>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
        <StackPanel Spacing="20">
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Text="Condition" FontSize="16" FontWeight="SemiBold" />
              <StackPanel Spacing="7">
                <TextBlock Text="{Binding PhysicalLabel}" Classes="muted" />
                <ItemsControl ItemsSource="{Binding PhysicalBoxes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConditionBoxViewModel">
                      <Button Classes="cm" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Tip}" BorderBrush="{StaticResource RedBrush}" Background="{Binding IsFilled, Converter={x:Static conv:BoolBrushConverter.Red}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="7">
                <TextBlock Text="{Binding StunLabel}" Classes="muted" />
                <ItemsControl ItemsSource="{Binding StunBoxes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConditionBoxViewModel">
                      <Button Classes="cm" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Tip}" BorderBrush="{StaticResource CyanBrush}" Background="{Binding IsFilled, Converter={x:Static conv:BoolBrushConverter.Cyan}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Border Height="1" Background="{StaticResource BorderBrush}" />
              <controls:EdgePoolView />
            </StackPanel>
          </Border>
          <Border Classes="panel">
            <StackPanel>
              <TextBlock Text="Combat" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding CombatStats}" ItemTemplate="{StaticResource OverviewStat}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="20">
          <Border Classes="panel">
            <StackPanel Spacing="10">
              <TextBlock Text="Attributes" FontSize="16" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Attributes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AttributeViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,18,6">
                      <TextBlock Text="{Binding LongName}" Classes="muted" />
                      <TextBlock Grid.Column="1" Text="{Binding Display}" FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="panel">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Limits and movement" FontSize="16" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Modifiers…" Command="{Binding EditLimitModifiersCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding DerivedStats}" ItemTemplate="{StaticResource OverviewStat}" />
            </StackPanel>
          </Border>
          <Border Classes="panel">
            <StackPanel Spacing="6">
              <TextBlock Text="Qualities" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding PositiveQualities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QualityViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,5" ToolTip.ShowDelay="300">
                      <ToolTip.Tip><StackPanel Width="340" Spacing="6"><TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" /><TextBlock Text="{Binding EffectSummary}" IsVisible="{Binding HasEffectSummary}" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding Source}" Classes="muted" /></StackPanel></ToolTip.Tip>
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding KarmaText}" Foreground="{StaticResource GreenBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding NegativeQualities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QualityViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,5" ToolTip.ShowDelay="300">
                      <ToolTip.Tip><StackPanel Width="340" Spacing="6"><TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" /><TextBlock Text="{Binding EffectSummary}" IsVisible="{Binding HasEffectSummary}" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding Source}" Classes="muted" /></StackPanel></ToolTip.Tip>
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding KarmaText}" Foreground="{StaticResource RedBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
