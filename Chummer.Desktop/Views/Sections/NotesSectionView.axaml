<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chummer.Desktop.ViewModels" x:Class="Chummer.Desktop.Views.Sections.NotesSectionView" x:DataType="vm:CharacterViewModel">
  <DockPanel Margin="28,22">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Info and notes" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Identity, appearance and your runner's story" Classes="muted" />
    </StackPanel>
    <TabControl DataContext="{Binding Info}" x:DataType="vm:CharacterInfoViewModel">
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="Identity" FontSize="14" />
        </TabItem.Header>
        <ScrollViewer>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Margin="0,18,0,0">
            <Border Classes="panel" VerticalAlignment="Top">
              <StackPanel Spacing="14">
                <TextBlock Text="Identity" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Spacing="5">
                  <TextBlock Text="Street name / alias" Classes="muted" />
                  <TextBox Text="{Binding Alias, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Spacing="5">
                  <TextBlock Text="Real name" Classes="muted" />
                  <TextBox Text="{Binding CharacterName, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Spacing="5">
                  <TextBlock Text="Player" Classes="muted" />
                  <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="panel" VerticalAlignment="Top">
              <StackPanel Spacing="14">
                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="90,*" ColumnSpacing="16">
                  <TextBlock Text="Sex" Classes="muted" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Gender, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Grid ColumnDefinitions="90,*" ColumnSpacing="16">
                  <TextBlock Text="Age" Classes="muted" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Age, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Grid ColumnDefinitions="90,*" ColumnSpacing="16">
                  <TextBlock Text="Height" Classes="muted" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Height, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Grid ColumnDefinitions="90,*" ColumnSpacing="16">
                  <TextBlock Text="Weight" Classes="muted" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Weight, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Grid ColumnDefinitions="90,*" ColumnSpacing="16">
                  <TextBlock Text="Eyes" Classes="muted" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Eyes, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Grid ColumnDefinitions="90,*" ColumnSpacing="16">
                  <TextBlock Text="Hair" Classes="muted" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Hair, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Grid ColumnDefinitions="90,*" ColumnSpacing="16">
                  <TextBlock Text="Skin" Classes="muted" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Skin, UpdateSourceTrigger=LostFocus}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="Concept" FontSize="14" />
        </TabItem.Header>
        <Grid Margin="0,16,0,0">
          <TextBox Text="{Binding Concept, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="18" />
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="Background" FontSize="14" />
        </TabItem.Header>
        <Grid Margin="0,16,0,0">
          <TextBox Text="{Binding Background, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="18" />
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="Description" FontSize="14" />
        </TabItem.Header>
        <Grid Margin="0,16,0,0">
          <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="18" />
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="Notes" FontSize="14" />
        </TabItem.Header>
        <Grid Margin="0,16,0,0">
          <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="18" />
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="GM notes" FontSize="14" />
        </TabItem.Header>
        <Grid Margin="0,16,0,0">
          <TextBox Text="{Binding GameNotes, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="18" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
