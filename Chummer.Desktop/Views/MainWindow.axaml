<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chummer.Desktop.ViewModels"
        xmlns:loc="using:Chummer.Desktop.Localization"
        xmlns:conv="using:Chummer.Desktop.Converters"
        x:Class="Chummer.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Chummer Native"
        Width="1440" Height="900" MinWidth="980" MinHeight="620">
  <Grid ColumnDefinitions="232,*" RowDefinitions="*,26">

    <!-- Navigation rail -->
    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="18,20,18,18" Spacing="2">
          <TextBlock Text="CHUMMER" FontSize="24" FontWeight="Black" LetterSpacing="4"
                     Foreground="{StaticResource HeaderGradient}" />
          <TextBlock Text="// NATIVE" Classes="label" Foreground="{StaticResource MagentaBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
          <Button Classes="nav" Content="Tools &amp; settings ▾">
            <Button.Flyout><MenuFlyout>
              <MenuItem Header="Character rules…" Command="{Binding EditCharacterSettingsCommand}" />
              <MenuItem Header="Preferences…" Command="{Binding GlobalOptionsCommand}" />
              <Separator />
              <MenuItem Header="Import Hero Lab portfolio…" Command="{Binding ImportHeroLabCommand}" />
              <MenuItem Header="Export game data…" Command="{Binding ExportGameDataCommand}" />
              <MenuItem Header="XML amendment editor…" Command="{Binding EditXmlDataCommand}" />
            </MenuFlyout></Button.Flyout>
          </Button>
          <ToggleButton x:Name="DiceNavigation" Classes="nav" IsChecked="{Binding IsDiceActive, Mode=OneWay}" Command="{Binding ShowDiceCommand}"
                        HotKey="Ctrl+R" ToolTip.Tip="Roll picker (Ctrl+R)">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource Icon.Dice}" Width="18" Height="18" Classes="hot" />
              <TextBlock Text="ROLL PICKER" LetterSpacing="1.5" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="2">
          <Button Classes="nav" Command="{Binding MasterIndexCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Data="{StaticResource Icon.SkillKnowledge}" Width="18" Height="18" /><TextBlock Text="MASTER INDEX" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding NewRunnerCommand}" HotKey="Ctrl+N">
            <StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Data="{StaticResource Icon.Roster}" Width="18" Height="18" /><TextBlock Text="+ NEW RUNNER" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="17,10" Margin="10,0,10,10"
                  Command="{Binding Palette.OpenCommand}" HotKey="Ctrl+K" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" Classes="muted" />
              <TextBlock Grid.Column="1" Text="Search…" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="CTRL K" Classes="label" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <ToggleButton Classes="nav" IsChecked="{Binding IsRosterActive, Mode=OneWay}" Command="{Binding ShowRosterCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource Icon.Roster}" Width="18" Height="18" />
              <TextBlock Text="{loc:Tr String_CharacterRoster, Case=upper}" LetterSpacing="1.5" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="17,10"
                  Command="{Binding OpenFileCommand}" HotKey="Ctrl+O">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource Icon.Open}" Width="18" Height="18" />
              <TextBlock Text="{loc:Tr Label_Open, Case=upper}" LetterSpacing="1.5" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock Text="OPEN RUNNERS" Classes="label" Margin="18,22,18,6" />
          <ItemsControl ItemsSource="{Binding OpenCharacters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CharacterViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="17,8"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowCharacterCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TabTitle}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Classes="ghost" Padding="8,4" Content="✕" FontSize="11"
                          ToolTip.Tip="Close"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseCharacterCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Current page -->
    <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding CurrentPage}" />

    <!-- Status line -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" Classes="label" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="160" Height="3"
                     Foreground="{StaticResource CyanBrush}" />
      </Grid>
    </Border>

    <!-- Global search (Ctrl+K) -->
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#B0050810" IsVisible="{Binding Palette.IsOpen}" ZIndex="100"
            PointerPressed="PaletteBackdrop_OnPointerPressed">
      <Border Width="720" VerticalAlignment="Top" Margin="0,110,0,0" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" BoxShadow="0 0 40 0 #4400E5FF" PointerPressed="PaletteCard_OnPointerPressed">
        <StackPanel>
          <Grid Margin="16,14">
            <TextBox x:Name="PaletteBox" Text="{Binding Palette.Query}" PlaceholderText="Search everything — items, spells, skills, contacts, rolls…"
                     FontSize="17" Padding="38,10,10,10" KeyDown="PaletteBox_OnKeyDown" />
            <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" Classes="muted" IsHitTestVisible="False" />
          </Grid>
          <ListBox ItemsSource="{Binding Palette.Results}" SelectedItem="{Binding Palette.Selected}" MaxHeight="460" Margin="0,0,0,8"
                   DoubleTapped="PaletteList_OnDoubleTapped" Tapped="PaletteList_OnDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteEntry">
                <Grid ColumnDefinitions="34,*" Margin="6,3">
                  <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconKeyConverter.Instance}}" Width="18" Height="18" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Classes="label" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="↑↓ select   ⏎ open   esc close" Classes="label" Margin="16,0,16,12" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
