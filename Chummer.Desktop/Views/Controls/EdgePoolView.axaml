<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             x:Class="Chummer.Desktop.Views.Controls.EdgePoolView"
             x:DataType="vm:CharacterViewModel">
  <!-- Edge points for the session: filled diamonds are points left. -->
  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Available Edge" Classes="label" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding EdgePoolText}" FontWeight="Bold" Foreground="{StaticResource MagentaBrush}" />
    </Grid>
    <ItemsControl ItemsSource="{Binding EdgePips}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:Boolean">
          <Border Classes="edgepip" Classes.on="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCareerMode}">
      <Button Classes="hot" Content="SPEND 1" Command="{Binding SpendEdgeCommand}" IsEnabled="{Binding CanSpendEdge}"
              ToolTip.Tip="Use a point of Edge (it comes back when the GM refreshes Edge)" />
      <Button Classes="ghost" Content="REGAIN 1" Command="{Binding RegainEdgeCommand}" IsEnabled="{Binding CanRegainEdge}" />
      <Button Classes="ghost" Content="REFRESH ALL" Command="{Binding RefreshEdgePoolCommand}" IsEnabled="{Binding CanRegainEdge}"
              ToolTip.Tip="Start of session / GM refresh: regain every spent point" />
    </StackPanel>
  </StackPanel>
</UserControl>
