<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             x:Class="Chummer.Desktop.Views.RosterView"
             x:DataType="vm:RosterViewModel">
  <DockPanel Margin="28,24,28,12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="{loc:Tr String_CharacterRoster, Case=upper}" Classes="h1" />
        <TextBlock Text="Favorites, recent files and your watch folder" Classes="muted" Margin="0,4,0,0" />
      </StackPanel>
      <TextBox Grid.Column="1" Width="300" Margin="0,0,12,0" VerticalAlignment="Center"
               Text="{Binding SearchText}" Watermark="Search runners...">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="8,0,0,0" Classes="muted" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="2" Classes="primary" Command="{Binding OpenFileCommand}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.Open}" Width="14" Height="14" Foreground="{StaticResource BaseBrush}" />
          <TextBlock Text="{loc:Tr Label_Open, Case=upper}" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid>
      <Border Classes="panel" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.Overview}" Width="72" Height="72" Classes="hot" />
          <TextBlock Text="NO RUNNERS ON FILE" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="Open a .chum5 file to get started. Recently opened characters show up here." Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RosterEntryViewModel">
              <Button Command="{Binding OpenCommand}" Padding="0" Margin="0,0,16,16" BorderThickness="0"
                      ToolTip.Tip="{Binding FilePath}">
                <Border Classes="panel lit" Width="300" Padding="0">
                  <Grid ColumnDefinitions="96,*">
                    <Border Background="{StaticResource SurfaceBrush}" Height="128">
                      <Grid>
                        <PathIcon Data="{StaticResource Icon.Overview}" Width="48" Height="48" Classes="muted"
                                  IsVisible="{Binding !HasPortrait}" />
                        <Image Source="{Binding Portrait}" Stretch="UniformToFill" IsVisible="{Binding HasPortrait}" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,12" Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                        <PathIcon Grid.Column="1" Data="{StaticResource Icon.Star}" Width="14" Height="14"
                                  Foreground="{StaticResource YellowBrush}" IsVisible="{Binding IsFavorite}" />
                      </Grid>
                      <TextBlock Text="{Binding RealName}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Metatype}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Border Classes="chip">
                          <TextBlock Text="{Binding Mode}" FontSize="10" LetterSpacing="1" Foreground="{StaticResource CyanBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HasKarma}">
                          <PathIcon Data="{StaticResource Icon.Karma}" Width="12" Height="12" Classes="hot" />
                          <TextBlock Text="{Binding Karma}" FontSize="12" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
