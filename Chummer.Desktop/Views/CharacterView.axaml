<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             xmlns:conv="using:Chummer.Desktop.Converters"
             x:Class="Chummer.Desktop.Views.CharacterView"
             x:DataType="vm:CharacterViewModel">
  <UserControl.Resources>
    <conv:IconKeyConverter x:Key="Icon" />
    <DataTemplate x:Key="ContactCard" x:DataType="vm:ContactCardViewModel">
      <Border Classes="dossier" Classes.enemy="{Binding IsEnemy}" Width="360" Margin="0,0,12,12" Padding="14,12">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="avatar" Width="46" Height="46" CornerRadius="23" Margin="0,0,12,0" VerticalAlignment="Top">
              <TextBlock Text="{Binding Initials}" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Classes="muted" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="chip" Margin="0,0,4,0" Padding="5,1">
                      <TextBlock Text="{Binding}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MagentaBrush}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <!-- Connection / loyalty -->
          <Grid ColumnDefinitions="100,*,Auto,Auto" RowDefinitions="Auto,Auto" ToolTip.Tip="Connection: how much clout and reach they have.  Loyalty: how much they care about you.">
            <TextBlock Text="CONNECTION" Classes="label" VerticalAlignment="Center" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding ConnectionPips}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:Boolean"><Border Classes="pip" Classes.on="{Binding}" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource CyanBrush}" MinWidth="22" TextAlignment="Right" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0" IsVisible="{Binding IsEditable}">
              <Button Classes="step" Content="−" Command="{Binding ConnectionDownCommand}" ToolTip.Tip="Lower connection" />
              <Button Classes="step" Content="+" Command="{Binding ConnectionUpCommand}" ToolTip.Tip="Raise connection" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="LOYALTY" Classes="label" VerticalAlignment="Center" Margin="0,4,0,0" />
            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LoyaltyPips}" VerticalAlignment="Center" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:Boolean"><Border Classes="pip loy" Classes.on="{Binding}" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LoyaltyText}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource MagentaBrush}" MinWidth="22" TextAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="8,4,0,0" IsVisible="{Binding IsEditable}">
              <Button Classes="step" Content="−" Command="{Binding LoyaltyDownCommand}" IsEnabled="{Binding LoyaltyEnabled}" ToolTip.Tip="Lower loyalty" />
              <Button Classes="step" Content="+" Command="{Binding LoyaltyUpCommand}" IsEnabled="{Binding LoyaltyEnabled}" ToolTip.Tip="Raise loyalty" />
            </StackPanel>
          </Grid>

          <!-- Dossier facts -->
          <ItemsControl ItemsSource="{Binding Facts}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ItemStat">
                <StackPanel Width="164" Margin="0,0,0,6">
                  <TextBlock Text="{Binding Label}" Classes="label" FontSize="9" />
                  <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border IsVisible="{Binding HasNotes}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0" Padding="8,2">
            <TextBlock Text="{Binding Notes}" Classes="muted" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notes}" />
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CardGroup" x:DataType="vm:InventoryGroupViewModel">
      <StackPanel Spacing="8" Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding Name}" Classes="h2" />
          <TextBlock Text="{Binding CountText}" Classes="label" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InventoryItemViewModel">
              <Border Classes="tile" Opacity="{Binding Opacity}" ToolTip.Placement="Right" ToolTip.ShowDelay="250">
                <ToolTip.Tip>
                  <StackPanel Width="320" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="28" Height="28" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" MaxWidth="270" />
                        <TextBlock Text="{Binding Category}" Classes="label" />
                      </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Stats}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemStat">
                          <StackPanel Width="100" Margin="0,0,4,6">
                            <TextBlock Text="{Binding Label}" Classes="label" />
                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ContentsText}" IsVisible="{Binding HasContents}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" TextWrapping="Wrap" Classes="muted" FontSize="12" MaxHeight="120" />
                    <Grid ColumnDefinitions="*,*,*">
                      <StackPanel>
                        <TextBlock Text="COST" Classes="label" />
                        <TextBlock Text="{Binding Cost}" Foreground="{StaticResource YellowBrush}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="AVAIL" Classes="label" />
                        <TextBlock Text="{Binding Avail}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="SOURCE" Classes="label" />
                        <TextBlock Text="{Binding Source}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </ToolTip.Tip>
                <Grid RowDefinitions="Auto,*,Auto">
                  <Grid ColumnDefinitions="*,Auto">
                    <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="30" Height="30" HorizontalAlignment="Left" />
                    <Border Grid.Column="1" Classes="chip" IsVisible="{Binding HasBadge}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource CyanBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,8,0,4" Foreground="{StaticResource TextBrush}" VerticalAlignment="Top" />
                  <TextBlock Grid.Row="2" Text="{Binding Headline}" Classes="label" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.dossier">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
    <Style Selector="Border.dossier:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Border.dossier.enemy">
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
    </Style>
    <Style Selector="Border.avatar">
      <Setter Property="Background" Value="{StaticResource CyanDimBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.dossier.enemy Border.avatar">
      <Setter Property="Background" Value="#33FF3355" />
      <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
    </Style>
    <Style Selector="Border.pip">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="Border.pip.on">
      <Setter Property="Background" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Border.pip.loy.on">
      <Setter Property="Background" Value="{StaticResource MagentaBrush}" />
    </Style>
    <Style Selector="Button.step">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <!-- A row or chip that rolls in the Dice Terminal when clicked. -->
    <Style Selector="Button.roll">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.roll:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A00E5FF" />
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Button.roll:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3300E5FF" />
    </Style>
    <Style Selector="Button.roll:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.roll PathIcon.rollhint">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Button.roll:pointerover PathIcon.rollhint">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="ToggleButton.section:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.cm">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.cm:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#55FFFFFF" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="196" />
      <Setter Property="Height" Value="134" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
      <Setter Property="BoxShadow" Value="0 0 14 0 #4400E5FF" />
    </Style>
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="MinWidth" Value="150" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="28,20,28,0">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="88" Height="88" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource CyanBrush}"
                  BorderThickness="1" ClipToBounds="True" BoxShadow="0 0 16 0 #3300E5FF">
            <Grid>
              <PathIcon Data="{StaticResource Icon.Overview}" Width="44" Height="44" Classes="muted" />
              <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="20,2,0,0" Spacing="4">
            <TextBlock Text="{Binding Name}" Classes="h1" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Metatype}" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="{Binding RealName}" Classes="muted" />
            </StackPanel>
            <Border Classes="chip" HorizontalAlignment="Left" Margin="0,4,0,0">
              <TextBlock Text="{Binding Mode}" FontSize="10" LetterSpacing="1" Foreground="{StaticResource CyanBrush}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
            <Border Classes="stat" BorderBrush="{StaticResource MagentaBrush}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Karma}" Width="12" Height="12" Classes="hot" />
                  <TextBlock Text="{loc:Tr Label_Karma, Case=upper}" Classes="label" />
                </StackPanel>
                <TextBlock Text="{Binding Karma}" Classes="value" />
              </StackPanel>
            </Border>
            <Border Classes="stat" BorderBrush="{StaticResource YellowBrush}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Nuyen}" Width="12" Height="12" Foreground="{StaticResource YellowBrush}" />
                  <TextBlock Text="{loc:Tr Label_Nuyen, Case=upper}" Classes="label" />
                </StackPanel>
                <TextBlock Text="{Binding Nuyen}" Classes="value" />
              </StackPanel>
            </Border>
            <Border Classes="stat" BorderBrush="{StaticResource CyanBrush}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Essence}" Width="12" Height="12" />
                  <TextBlock Text="{loc:Tr Label_Essence, Case=upper}" Classes="label" />
                </StackPanel>
                <TextBlock Text="{Binding Essence}" Classes="value" />
              </StackPanel>
            </Border>
            <Button Classes="primary" Command="{Binding SaveCommand}" VerticalAlignment="Stretch" HotKey="Ctrl+S">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Save}" Width="18" Height="18" Foreground="{StaticResource BaseBrush}" />
                <TextBlock Text="SAVE" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <ToggleButton Classes="section" Content="OVERVIEW" IsChecked="{Binding IsOverview, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Overview}" />
          <ToggleButton Classes="section" Content="{loc:Tr Label_Attributes, Case=upper}" IsChecked="{Binding IsAttributes, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Attributes}" />
          <ToggleButton Classes="section" Content="{loc:Tr Tab_Skills, Case=upper}" IsChecked="{Binding IsSkills, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Skills}" />
          <ToggleButton Classes="section" Content="{loc:Tr String_Qualities, Case=upper}" IsChecked="{Binding IsQualities, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Qualities}" />
          <ToggleButton Classes="section" Content="INVENTORY" IsChecked="{Binding IsInventory, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Inventory}" />
          <ToggleButton Classes="section" Content="ABILITIES" IsChecked="{Binding IsAbilities, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Abilities}" />
          <ToggleButton Classes="section" Content="CONTACTS" IsChecked="{Binding IsNetwork, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Network}" />
          <ToggleButton Classes="section" Content="{loc:Tr Tab_Notes, Case=upper}" IsChecked="{Binding IsNotes, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Notes}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Sections -->
    <Grid>
      <!-- Overview -->
      <ScrollViewer IsVisible="{Binding IsOverview}">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="28,22" >
          <!-- Vitals -->
          <Border Grid.ColumnSpan="2" Classes="panel lit" Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,*,1.3*">
              <StackPanel Spacing="12">
                <TextBlock Text="CONDITION" Classes="h2" />
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding PhysicalLabel}" Classes="label" />
                  <ItemsControl ItemsSource="{Binding PhysicalBoxes}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConditionBoxViewModel">
                        <Button Classes="cm" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Tip}" BorderBrush="{StaticResource RedBrush}"
                                Background="{Binding IsFilled, Converter={x:Static conv:BoolBrushConverter.Red}}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding StunLabel}" Classes="label" />
                  <ItemsControl ItemsSource="{Binding StunBoxes}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConditionBoxViewModel">
                        <Button Classes="cm" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Tip}" BorderBrush="{StaticResource CyanBrush}"
                                Background="{Binding IsFilled, Converter={x:Static conv:BoolBrushConverter.Cyan}}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" Margin="20,0">
                <TextBlock Text="COMBAT" Classes="h2" />
                <ItemsControl ItemsSource="{Binding CombatStats}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemStat">
                      <Panel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPlain}" Margin="0,4">
                          <TextBlock Text="{Binding Label}" Classes="muted" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                        </Grid>
                      <Button Classes="roll" Margin="-6,0" IsVisible="{Binding IsRollable}"
                              Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding RollName}"
                              ToolTip.Tip="{Binding RollName, StringFormat='Click to roll {0} and copy it for Roll20'}" ToolTip.IsEnabled="{Binding IsRollable}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Text="{Binding Label}" Classes="muted" />
                          <PathIcon Grid.Column="1" Classes="rollhint" Data="{StaticResource Icon.Dice}" Margin="0,0,8,0" IsVisible="{Binding IsRollable}" />
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" />
                        </Grid>
                      </Button>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="8">
                <TextBlock Text="LIMITS &amp; DERIVED" Classes="h2" />
                <ItemsControl ItemsSource="{Binding DerivedStats}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemStat">
                      <Panel>
                      <Border Classes="chip" Padding="10,6" MinWidth="96" Margin="0,0,6,6" IsVisible="{Binding IsPlain}">
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" Classes="label" />
                          <TextBlock Text="{Binding Value}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource CyanBrush}" />
                        </StackPanel>
                      </Border>
                      <Button Classes="roll" Margin="0,0,6,6" Padding="0" IsVisible="{Binding IsRollable}"
                              Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding RollName}"
                              ToolTip.Tip="{Binding RollName, StringFormat='Click to roll {0} and copy it for Roll20'}" ToolTip.IsEnabled="{Binding IsRollable}">
                        <Border Classes="chip" Padding="10,6" MinWidth="96">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" Classes="label" />
                              <TextBlock Text="{Binding Value}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource CyanBrush}" />
                            </StackPanel>
                            <PathIcon Grid.Column="1" Classes="rollhint" Data="{StaticResource Icon.Dice}" VerticalAlignment="Top" Margin="6,0,0,0" IsVisible="{Binding IsRollable}" />
                          </Grid>
                        </Border>
                      </Button>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Classes="panel lit" Margin="0,0,10,0" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Text="{loc:Tr Label_Attributes, Case=upper}" Classes="h2" />
              <ItemsControl ItemsSource="{Binding Attributes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AttributeViewModel">
                    <Grid ColumnDefinitions="28,60,*,48,30" Margin="0,4">
                      <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="16" Height="16" />
                      <TextBlock Grid.Column="1" Text="{Binding Abbrev}" FontWeight="Bold" VerticalAlignment="Center" />
                      <ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding Fill}" Height="6"
                                   Foreground="{StaticResource CyanBrush}" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Display}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                      <Button Grid.Column="4" Classes="ghost" Content="+" Padding="0" Width="22" Height="22" HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                              Command="{Binding QuickRaiseCommand}" IsEnabled="{Binding CanQuickRaise}" ToolTip.Tip="{Binding QuickRaiseTip}" ToolTip.ShowOnDisabled="True" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Classes="panel hot" Margin="10,0,0,0" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Tr String_Qualities, Case=upper}" Classes="h2" Foreground="{StaticResource MagentaBrush}" />
              <ItemsControl ItemsSource="{Binding PositiveQualities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QualityViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3" ToolTip.Tip="{Binding Source}">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Text="{Binding KarmaText}" Foreground="{StaticResource GreenBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding NegativeQualities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QualityViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3" ToolTip.Tip="{Binding Source}">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Text="{Binding KarmaText}" Foreground="{StaticResource RedBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- Attributes -->
      <ScrollViewer IsVisible="{Binding IsAttributes}">
        <StackPanel Margin="28,22" Spacing="18">
          <ItemsControl ItemsSource="{Binding Attributes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AttributeViewModel">
                <Border Classes="panel lit" Width="200" Margin="0,0,14,14">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="22" Height="22" />
                      <TextBlock Text="{Binding Abbrev}" Classes="h2" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" Classes="muted" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Display}" Classes="value" FontSize="30" />
                      <TextBlock Text="{Binding MaximumText}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fill}" Height="4"
                                 Foreground="{StaticResource CyanBrush}" Background="{StaticResource SurfaceBrush}" />
                    <StackPanel IsVisible="{Binding IsCareer}" Spacing="6">
                      <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Command="{Binding ImproveCommand}" IsEnabled="{Binding CanImprove}" ToolTip.Tip="{Binding QuickRaiseTip}" ToolTip.ShowOnDisabled="True">
                        <TextBlock Text="{Binding ImproveButtonText}" FontWeight="Bold" />
                      </Button>
                      <Button Classes="hot" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding CanBurnEdge}"
                              Command="{Binding BurnEdgeCommand}" Content="BURN 1 EDGE" ToolTip.Tip="Permanently lose a point of Edge" />
                    </StackPanel>
                    <Grid IsVisible="{Binding IsCreate}" ColumnDefinitions="Auto,*,Auto">
                      <Button Classes="ghost" Content="−" Width="30" HorizontalContentAlignment="Center" Command="{Binding LowerCommand}" ToolTip.Tip="Lower by 1 (karma points first)" />
                      <TextBlock Grid.Column="1" Text="{Binding PointsText}" Classes="muted" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="primary" Content="+" Width="30" HorizontalContentAlignment="Center" Command="{Binding RaiseCommand}" ToolTip.Tip="Raise by 1 (priority points first, then karma)" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding SpecialAttributes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AttributeViewModel">
                <Border Classes="panel hot" Width="200" Margin="0,0,14,14">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="22" Height="22" Classes="hot" />
                      <TextBlock Text="{Binding Abbrev}" Classes="h2" Foreground="{StaticResource MagentaBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" Classes="muted" />
                    <TextBlock Text="{Binding Display}" Classes="value" FontSize="30" />
                    <StackPanel IsVisible="{Binding IsCareer}" Spacing="6">
                      <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Command="{Binding ImproveCommand}" IsEnabled="{Binding CanImprove}" ToolTip.Tip="{Binding QuickRaiseTip}" ToolTip.ShowOnDisabled="True">
                        <TextBlock Text="{Binding ImproveButtonText}" FontWeight="Bold" />
                      </Button>
                      <Button Classes="hot" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding CanBurnEdge}"
                              Command="{Binding BurnEdgeCommand}" Content="BURN 1 EDGE" ToolTip.Tip="Permanently lose a point of Edge" />
                    </StackPanel>
                    <Grid IsVisible="{Binding IsCreate}" ColumnDefinitions="Auto,*,Auto">
                      <Button Classes="ghost" Content="−" Width="30" HorizontalContentAlignment="Center" Command="{Binding LowerCommand}" ToolTip.Tip="Lower by 1 (karma points first)" />
                      <TextBlock Grid.Column="1" Text="{Binding PointsText}" Classes="muted" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="primary" Content="+" Width="30" HorizontalContentAlignment="Center" Command="{Binding RaiseCommand}" ToolTip.Tip="Raise by 1 (priority points first, then karma)" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Skills -->
      <DockPanel IsVisible="{Binding IsSkills}" Margin="28,22,28,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,14">
          <TextBox Width="320" Text="{Binding SkillFilter}" PlaceholderText="Search skills...">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="8,0,0,0" Classes="muted" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <CheckBox Content="Show untrained" IsChecked="{Binding ShowUntrainedSkills}" />
        </StackPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding SkillCategories}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SkillCategoryViewModel">
                <Border Classes="panel lit" Width="420" Margin="0,0,16,16" VerticalAlignment="Top">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                      <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="20" Height="20" />
                      <TextBlock Text="{Binding Name}" Classes="h2" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Skills}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkillViewModel">
                          <Grid ColumnDefinitions="*,Auto" Margin="-6,0">
                            <Button Classes="roll" IsEnabled="{Binding IsRollable}" ToolTip.Tip="{Binding RollTip}"
                                    Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding RollName}">
                              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Specialization}" IsVisible="{Binding HasSpecialization}" FontSize="10"
                                             Foreground="{StaticResource MagentaBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <PathIcon Grid.Column="1" Classes="rollhint" Data="{StaticResource Icon.Dice}" Margin="0,0,6,0" />
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Pips}" VerticalAlignment="Center" Margin="0,0,8,0">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:Boolean">
                                  <Border Width="7" Height="12" CornerRadius="1" Classes.on="{Binding}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                              <ItemsControl.Styles>
                                <Style Selector="Border">
                                  <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                                </Style>
                                <Style Selector="Border.on">
                                  <Setter Property="Background" Value="{StaticResource CyanBrush}" />
                                </Style>
                              </ItemsControl.Styles>
                            </ItemsControl>
                                <Border Grid.Column="3" Classes="chip" MinWidth="34" ToolTip.Tip="Dice pool">
                                  <TextBlock Text="{Binding Pool}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                </Border>
                              </Grid>
                            </Button>
                            <Button Grid.Column="1" Classes="roll" IsVisible="{Binding HasSpecPool}" Margin="2,0,0,0" Padding="2"
                                    ToolTip.Tip="{Binding Specialization, StringFormat='Click to roll with the {0} specialization'}"
                                    Command="{Binding $parent[UserControl].((vm:CharacterViewModel)DataContext).RollCommand}" CommandParameter="{Binding SpecRollName}">
                              <Border Classes="chip" MinWidth="34" Background="{StaticResource MagentaDimBrush}" BorderBrush="{StaticResource MagentaBrush}">
                                <TextBlock Text="{Binding SpecPool}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource MagentaBrush}" />
                              </Border>
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Qualities -->
      <ScrollViewer IsVisible="{Binding IsQualities}">
        <Grid ColumnDefinitions="*,*" Margin="28,22">
          <Border Classes="panel lit" Margin="0,0,10,0" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <TextBlock Text="POSITIVE" Classes="h2" Foreground="{StaticResource GreenBrush}" />
              <ItemsControl ItemsSource="{Binding PositiveQualities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QualityViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                      <PathIcon Data="{StaticResource Icon.Quality}" Width="16" Height="16" Foreground="{StaticResource GreenBrush}" />
                      <StackPanel Grid.Column="1" Margin="10,0">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Source}" Classes="label" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding KarmaText}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="panel hot" Margin="10,0,0,0" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <TextBlock Text="NEGATIVE" Classes="h2" Foreground="{StaticResource RedBrush}" />
              <ItemsControl ItemsSource="{Binding NegativeQualities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QualityViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                      <PathIcon Data="{StaticResource Icon.Quality}" Width="16" Height="16" Foreground="{StaticResource RedBrush}" />
                      <StackPanel Grid.Column="1" Margin="10,0">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Source}" Classes="label" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding KarmaText}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- Inventory -->
      <DockPanel IsVisible="{Binding IsInventory}" Margin="28,22,28,0">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
          <Grid ColumnDefinitions="*,Auto">
            <Grid>
              <TextBox Text="{Binding InventoryFilter}" PlaceholderText="Search inventory… (smartgun, armor, commlink, medkit)" Padding="40,9,10,9" />
              <PathIcon Data="{StaticResource Icon.Search}" Width="15" Height="15" HorizontalAlignment="Left" Margin="14,0,0,0" Classes="muted" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding InventorySummary}" Classes="label" VerticalAlignment="Center" Margin="14,0,0,0" />
          </Grid>
          <ItemsControl ItemsSource="{Binding InventoryKinds}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InventoryFilterOption">
                <ToggleButton Classes="section" Margin="0,0,4,0" Padding="12,6" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="14" Height="14" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding InventoryGroups}" ItemTemplate="{StaticResource CardGroup}" Margin="0,0,0,22">
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Abilities -->
      <DockPanel IsVisible="{Binding IsAbilities}" Margin="28,22,28,0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
          <TextBox Text="{Binding AbilityFilter}" PlaceholderText="Search spells, powers, forms, techniques…" Padding="40,9,10,9" />
          <PathIcon Data="{StaticResource Icon.Search}" Width="15" Height="15" HorizontalAlignment="Left" Margin="14,0,0,0" Classes="muted" IsHitTestVisible="False" />
        </Grid>
        <Grid>
          <StackPanel IsVisible="{Binding !HasAbilities}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <PathIcon Data="{StaticResource Icon.Spell}" Width="40" Height="40" Classes="muted" />
            <TextBlock Text="No spells, powers or other abilities." Classes="muted" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding AbilityGroups}" ItemTemplate="{StaticResource CardGroup}" Margin="0,0,0,22" />
          </ScrollViewer>
        </Grid>
      </DockPanel>

      <!-- Contacts / spirits -->
      <DockPanel IsVisible="{Binding IsNetwork}" Margin="28,22,28,0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
          <TextBox Text="{Binding NetworkFilter}" PlaceholderText="Search contacts by name, role, location, payment, vice, notes… or spirits and sprites" Padding="40,9,10,9" />
          <PathIcon Data="{StaticResource Icon.Search}" Width="15" Height="15" HorizontalAlignment="Left" Margin="14,0,0,0" Classes="muted" IsHitTestVisible="False" />
        </Grid>
        <ScrollViewer>
          <StackPanel Margin="0,0,0,22" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasContactCards}">
              <TextBlock Text="CONTACTS" Classes="h2" />
              <TextBlock Text="{Binding ContactCountText}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Text="sorted by connection + loyalty" Classes="muted" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ContactCards}" ItemTemplate="{StaticResource ContactCard}" IsVisible="{Binding HasContactCards}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="ENEMIES" Classes="h2" Foreground="{StaticResource RedBrush}" IsVisible="{Binding HasEnemyCards}" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding EnemyCards}" ItemTemplate="{StaticResource ContactCard}" IsVisible="{Binding HasEnemyCards}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="PETS" Classes="h2" IsVisible="{Binding HasPetCards}" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding PetCards}" ItemTemplate="{StaticResource ContactCard}" IsVisible="{Binding HasPetCards}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding NetworkGroups}" ItemTemplate="{StaticResource CardGroup}" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- Notes -->
      <ScrollViewer IsVisible="{Binding IsNotes}">
        <StackPanel Margin="28,22" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
          <Border Classes="panel lit">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Label_Concept, Case=upper}" Classes="h2" />
              <SelectableTextBlock Text="{Binding Concept}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="panel lit">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Label_Description, Case=upper}" Classes="h2" />
              <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="panel lit">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Label_Background, Case=upper}" Classes="h2" />
              <SelectableTextBlock Text="{Binding Background}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="panel hot">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Tab_Notes, Case=upper}" Classes="h2" Foreground="{StaticResource MagentaBrush}" />
              <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
