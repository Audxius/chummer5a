<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chummer.Desktop.ViewModels"
             xmlns:loc="using:Chummer.Desktop.Localization"
             xmlns:conv="using:Chummer.Desktop.Converters"
             xmlns:sections="using:Chummer.Desktop.Views.Sections"
             x:Class="Chummer.Desktop.Views.CharacterView"
             x:DataType="vm:CharacterViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCharacterCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
  </UserControl.KeyBindings>
  <DockPanel IsEnabled="{Binding CanInteract}">
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="24,18,24,0">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Classes="portrait" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                  ToolTip.Tip="Click to set or change the portrait">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Choose portrait image…" Command="{Binding ChangePortraitCommand}" />
                <MenuItem Header="Remove portrait" Command="{Binding RemovePortraitCommand}" IsEnabled="{Binding HasPortrait}" />
              </MenuFlyout>
            </Button.Flyout>
            <Border Width="64" Height="64" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource CyanBrush}"
                    BorderThickness="1" ClipToBounds="True" >
              <Grid>
                <StackPanel IsVisible="{Binding !HasPortrait}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                  <PathIcon Data="{StaticResource Icon.Overview}" Width="36" Height="36" Classes="muted" />
                  <TextBlock Text="+ PHOTO" FontSize="9" LetterSpacing="1" Classes="muted" HorizontalAlignment="Center" />
                </StackPanel>
                <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
              </Grid>
            </Border>
          </Button>
          <StackPanel Grid.Column="1" Margin="20,2,0,0" Spacing="4" ClipToBounds="True">
            <TextBlock Text="{Binding Name}" Classes="h1" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Metatype}" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="{Binding RealName}" Classes="muted" />
            </StackPanel>
            <Border Classes="chip" HorizontalAlignment="Left" Margin="0,4,0,0">
              <TextBlock Text="{Binding Mode}" FontSize="10" LetterSpacing="1" Foreground="{StaticResource CyanBrush}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
            <Border Classes="stat" BorderBrush="{StaticResource MagentaBrush}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Karma}" Width="12" Height="12" Classes="hot" />
                  <TextBlock Text="{loc:Tr Label_Karma, Case=upper}" Classes="label" />
                </StackPanel>
                <TextBlock Text="{Binding Karma}" Classes="value" />
              </StackPanel>
            </Border>
            <Border Classes="stat" BorderBrush="{StaticResource YellowBrush}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Nuyen}" Width="12" Height="12" Foreground="{StaticResource YellowBrush}" />
                  <TextBlock Text="{loc:Tr Label_Nuyen, Case=upper}" Classes="label" />
                </StackPanel>
                <TextBlock Text="{Binding Nuyen}" Classes="value" />
              </StackPanel>
            </Border>
            <Border Classes="stat" BorderBrush="{StaticResource CyanBrush}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Essence}" Width="12" Height="12" />
                  <TextBlock Text="{loc:Tr Label_Essence, Case=upper}" Classes="label" />
                </StackPanel>
                <TextBlock Text="{Binding Essence}" Classes="value" />
              </StackPanel>
            </Border>
            <Button Classes="ghost" VerticalAlignment="Stretch" ToolTip.Tip="Print, export, create a PACKS kit, or save a copy">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Print character…" Command="{Binding PrintCommand}" />
                  <MenuItem Header="Export JSON / XML / Squad Manager…" Command="{Binding ExportCharacterCommand}" />
                  <MenuItem Header="Create PACKS kit…" Command="{Binding ExportPacksKitCommand}" />
                  <MenuItem Header="Print all open runners…" Command="{Binding PrintAllOpenCommand}" />
                  <Separator />
                  <MenuItem Header="Save a copy…" Command="{Binding SaveAsCommand}" />
                </MenuFlyout>
              </Button.Flyout>
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Notes}" Width="18" Height="18" />
                <TextBlock Text="Output ▾" />
              </StackPanel>
            </Button>
            <Button Classes="primary" Command="{Binding SaveCommand}" VerticalAlignment="Stretch" HotKey="Ctrl+S" ToolTip.Tip="Save (Ctrl+S). Right-click for Save As (Ctrl+Shift+S)">
              <Button.ContextFlyout>
                <MenuFlyout>
                  <MenuItem Header="Save as…" Command="{Binding SaveAsCommand}" />
                </MenuFlyout>
              </Button.ContextFlyout>
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Save}" Width="18" Height="18" Foreground="{StaticResource BaseBrush}" />
                <TextBlock Text="SAVE" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <StackPanel IsVisible="{Binding IsCreateMode}" Margin="0,14,0,0" Spacing="8" IsEnabled="{Binding !IsCheckingCreation}">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding CreationBudget}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource CyanBrush}" />
            <Button Grid.Column="1" Content="Creation tools ▾"><Button.Flyout><MenuFlyout>
              <MenuItem Header="Metatype and priorities…" Command="{Binding ChangeCreationPrioritiesCommand}" />
              <MenuItem Header="Convert Karma to nuyen…" Command="{Binding BuyCreationNuyenCommand}" />
              <MenuItem Header="Add PACKS kit…" Command="{Binding AddPacksKitCommand}" />
            </MenuFlyout></Button.Flyout></Button>
            <Button Grid.Column="2" Content="Check build" Command="{Binding ValidateCreationCommand}" />
            <Button Grid.Column="3" Content="Finish creation" Command="{Binding FinishCreationCommand}" Classes="primary" />
          </Grid>
          <ScrollViewer MaxHeight="160" IsVisible="{Binding HasCreationErrors}">
            <TextBlock Text="{Binding CreationErrors}" TextWrapping="Wrap" />
          </ScrollViewer>

        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal">
          <ToggleButton Classes="section" Content="OVERVIEW" IsChecked="{Binding IsOverview, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Overview}" />
          <ToggleButton Classes="section" Content="{loc:Tr Label_Attributes, Case=upper}" IsChecked="{Binding IsAttributes, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Attributes}" />
          <ToggleButton Classes="section" Content="{loc:Tr Tab_Skills, Case=upper}" IsChecked="{Binding IsSkills, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Skills}" />
          <ToggleButton Classes="section" Content="{loc:Tr String_Qualities, Case=upper}" IsChecked="{Binding IsQualities, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Qualities}" />
          <ToggleButton Classes="section" Content="INVENTORY" IsChecked="{Binding IsInventory, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Inventory}" />
          <ToggleButton Classes="section" Content="ABILITIES" IsChecked="{Binding IsAbilities, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Abilities}" />
          <ToggleButton Classes="section" Content="CONTACTS" IsChecked="{Binding IsNetwork, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Network}" />
          <ToggleButton Classes="section" Content="INFO &amp; NOTES" IsChecked="{Binding IsNotes, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Notes}" />
          <ToggleButton Classes="section" Content="LEDGER" IsChecked="{Binding IsLedger, Mode=OneWay}" IsVisible="{Binding Ledger.IsCareer}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Ledger}" />
          <ToggleButton Classes="section" Content="IMPROVEMENTS" IsChecked="{Binding IsImprovements, Mode=OneWay}"
                        Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:CharacterSection.Improvements}" />
        </StackPanel>
        </ScrollViewer>
        <Button x:Name="CharacterRollPicker" Grid.Column="1" Content="Roll picker" Command="{Binding OpenRollPickerCommand}" VerticalAlignment="Center" ToolTip.Tip="Choose a roll for this character (Ctrl+R)" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Sections -->
    <Grid>
      <sections:OverviewSectionView IsVisible="{Binding IsOverview}" />

      <sections:AttributesSectionView IsVisible="{Binding IsAttributes}" />

      <sections:SkillsSectionView IsVisible="{Binding IsSkills}" />

      <sections:QualitiesSectionView IsVisible="{Binding IsQualities}" />

      <sections:InventorySectionView IsVisible="{Binding IsInventory}" />

      <sections:AbilitiesSectionView IsVisible="{Binding IsAbilities}" />

      <sections:ContactsSectionView IsVisible="{Binding IsNetwork}" />

      <sections:NotesSectionView IsVisible="{Binding IsNotes}" />

      <sections:LedgerSectionView IsVisible="{Binding IsLedger}" />
      <sections:ImprovementsSectionView IsVisible="{Binding IsImprovements}" />
    </Grid>
  </DockPanel>
</UserControl>
